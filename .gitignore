**/__pycache__/
*.png
*.jpg
*.gif
*.svg
.venv/
.idea/
*.egg-info
/build/
/output
/models
# Run output: vectrify writes <output-stem>/runs/ next to the output file
*/runs/

# Agent metadata, worktrees, and coverage artifacts
.claude/
.codex/
.coverage

# The benchmark corpus is source, not run output
!bench/cases/**
# So is the synthetic distortion set: drawings damaged by a known amount, in a
# known order, so a scorer can be checked without another scorer to judge it.
!bench/distortions/**

# Run artifacts: a run writes its log and lineage next to the input image.
duck*/
