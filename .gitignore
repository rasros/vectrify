**/__pycache__/
*.png
*.jpg
*.gif
*.svg
.venv/
.idea/
*.egg-info
/build/
/bench/results/
/output
/models
# Run output: vectrify writes <output-stem>/runs/ next to the output file
*/runs/

# Agent metadata, worktrees, and coverage artifacts
.claude/
.codex/
.coverage

# Run artifacts: a run writes its log and lineage next to the input image.
duck*/

# Editor source assets, the line bench's own drawings and local native
# extension builds
!src/vectrify/ui/static/*.svg
!scripts/bench_data/svg/*.svg
*.so

# Projects and references saved into a checkout while trying the editor
/*.vectrify
/*.png
/*.jpg
/*.jpeg
/*.webp
/.bench/
