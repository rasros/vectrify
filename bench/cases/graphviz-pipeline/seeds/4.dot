digraph Pipeline {
    graph [rankdir=LR, ranksep=0.55, nodesep=0.52, bgcolor="white", pad=0.15];
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16,
          color="#334155", penwidth=1.2, fillcolor="#b2d3f4", margin="0.20,0.12"];
    edge [color="#475569", penwidth=1.2, arrowsize=0.8];
    ingest [label="Ingest"];
    clean [label="Clean"];
    publish [label="Publish", fillcolor="#bef264"];
    ingest -> clean -> publish;
}
